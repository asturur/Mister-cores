<misterromdescription>
    <about author="Andrea Bogazzi" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Super Volleyball (Korea)</name>
    <setname>svolleyk</setname>
    <mameversion>0282</mameversion>
    <year>1989</year>
    <manufacturer>V-System Co.</manufacturer>
    <players>2</players>
    <rbf>jtsvolle</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="svolleyk.zip|svolley.zip" md5="None" address="0x30000000">
        <!--  -->
        <part>
            00 00 00 00 </part>
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="a11.bin" crc="92afd56f" map="01"/>
            <part name="a14.bin" crc="dbab3bf9" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="a12.bin" crc="de3dd5cb" map="01"/>
            <part name="a15.bin" crc="d8f89c4a" map="10"/>
        </interleave>
        <part repeat="0x10000"> FF</part>
        <part repeat="0x40000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- tiles1 - starts at 0x80000 - length 0x80000 (19 bits) -->
        <part name="sps_02.bin" crc="1a0abe75"/>
        <part name="sps_03.bin" crc="36279075"/>
        <part name="sps_04.bin" crc="7cede7d9"/>
        <part name="sps_01.bin" crc="6425e6d7"/>
        <part repeat="0x8000"> FF</part>
        <part name="sps_10.bin" crc="a12b1589"/>
        <part repeat="0x38000"> FF</part>
        <!-- SCR1_START -->
        <!-- tiles2 - starts at 0x100000 - length 0x80000 (19 bits) -->
        <part name="sps_05.bin" crc="b0671d12"/>
        <part name="sps_06.bin" crc="c231957e"/>
        <part name="sps_07.bin" crc="904b7709"/>
        <part name="sps_08.bin" crc="5430ffac"/>
        <part name="sps_09.bin" crc="414a6278"/>
        <part name="a09.bin" crc="dd92dfe1"/>
        <part repeat="0x28000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- sprites - starts at 0x180000 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="sps_20.bin" crc="c9e7206d" map="01"/>
            <part name="sps_23.bin" crc="7b15c805" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sps_19.bin" crc="8ac2f232" map="01"/>
            <part name="sps_22.bin" crc="fcc754e3" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sps_18.bin" crc="4d6c8f0c" map="01"/>
            <part name="sps_21.bin" crc="9dd28b42" map="10"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <interleave output="16">
            <part name="sps_18.bin" crc="4d6c8f0c" map="01"/>
            <part name="sps_21.bin" crc="9dd28b42" map="10"/>
        </interleave>
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- audiocpu - starts at 0x200000 - length 0x10000 (16 bits) -->
        <part name="sps_17.bin" crc="48b89688"/>
        <!-- PCM_START -->
        <!-- upd - starts at 0x210000 - length 0x40000 (18 bits) -->
        <part name="sps_16.bin" crc="456d0f36"/>
        <part name="sps_15.bin" crc="f33f415f"/>
        <part repeat="0x10000"> FF</part>
        <!-- Total 0x250000 bytes - 2368 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="00,40">
        <DSW/>
        <dip name="Coin A" bits="0,3" ids="1/1,-,4/5,5/6,1/6,6/4,2/3,-,1/2,1/3,1/4,1/5,2/1,3/1,-,-"/>
        <dip name="Coin B" bits="4,7" ids="1/1,-,4/5,5/6,1/6,6/4,2/3,-,1/2,1/3,1/4,1/5,2/1,3/1,-,-"/>
        <dip name="Game Time" bits="8" ids="3 min/1.5 min,2 min/1 min"/>
        <dip name="2P Start Score" bits="9,10" ids="7-7,9-9,5-5,0-0"/>
        <dip name="1P Start Score" bits="11,12" ids="11-11,10-11,9-11,10-10"/>
        <dip name="Service Mode" bits="13" ids="Off,On"/>
        <dip name="Demo Sounds" bits="14" ids="Off,On"/>
        <dip name="Flip Screen" bits="15" ids="Off,On"/>
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
